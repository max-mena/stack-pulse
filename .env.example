# Copy to .env and fill in. .env is gitignored — never commit real values.

# GitHub fine-grained token: Settings → Developer settings → Fine-grained tokens
# Repository access: "Public repositories (read-only)", no extra permissions.
GITHUB_TOKEN=

# Stack Exchange app key (the "Key", not the client secret): https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=

# Google Cloud. Auth locally with: gcloud auth application-default login
GCP_PROJECT_ID=
BQ_LOCATION=US
BQ_RAW_DATASET=raw
